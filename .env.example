# ===== App =====
APP_NAME=Kocaeli News Map API
APP_VERSION=0.1.0
APP_ENV=dev

# ===== MongoDB =====
MONGO_URL=mongodb://localhost:27017
MONGO_DB=kocaeli_news

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Embedding =====
EMBEDDING_TEXT_PROVIDER=mock
EMBEDDING_IMAGE_PROVIDER=mock
EMBEDDING_TEXT_DIM=1024
EMBEDDING_IMAGE_DIM=768
DUPLICATE_THRESHOLD=0.90
DUPLICATE_TEXT_WEIGHT=0.85
DUPLICATE_IMAGE_WEIGHT=0.15
EMBEDDING_COST_LOG=logs/embedding_cost.jsonl
CLASSIFIER_SEMANTIC_ENABLED=false
CLASSIFIER_SEMANTIC_THRESHOLD=0.3
CLASSIFIER_KEYWORD_ONLY=true

# ===== Next.js Public =====
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===== MCP =====
MCP_LEASE_TTL=300
MCP_IDEMPOTENCY_TTL=86400
MCP_QUEUE_SIZE=1000
MCP_MAX_RETRIES=3
MCP_FAIL_CLOSED=true
MCP_HOST=0.0.0.0
MCP_PORT=8001
WORKER_ID=
