  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node --test --test-isolation=none --test-concurrency=1 tests/**/*.test.mts",
