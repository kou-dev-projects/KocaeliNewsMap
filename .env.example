# ===== App =====
APP_NAME=PULSE Backend
APP_VERSION=0.1.0
APP_ENV=dev

# ===== MongoDB =====
# Local example:
MONGO_URL=mongodb://localhost:27017
MONGO_DOCKER_URL=mongodb://mongodb:27017
MONGO_DB=kocaeli_news

# Optional / legacy, only keep if some other module really uses it
# MONGO_URI=mongodb://localhost:27017/pulse

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Scheduler =====
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Europe/Istanbul
SCHEDULER_INTERVAL_HOURS=3
SCHEDULER_LOOKBACK_DAYS=3
SCHEDULER_MAX_URLS_PER_SOURCE=10
# Temporarily disable sources by domain (comma-separated):
# SCHEDULER_SKIP_DOMAINS=yenikocaeli.com

# ===== Scrape Trigger / Job Queue =====
# Scrape control-plane routes are open in local development.
# Keep this only if another internal diagnostics route still expects it.
SCRAPE_TRIGGER_API_KEY=
SCRAPE_TRIGGER_RATE_LIMIT_ENABLED=true
SCRAPE_TRIGGER_RATE_LIMIT_REQUESTS=5
SCRAPE_TRIGGER_RATE_LIMIT_WINDOW_SECONDS=60
# Trust X-Forwarded-For only when it comes from these proxy CIDRs.
TRUSTED_PROXY_CIDRS=
JOB_TTL_SECONDS=86400
JOB_CLAIM_IDLE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=5
SCHEDULED_JOB_LOCK_TTL_SECONDS=21600

# ===== Scrape Events / SSE Stream =====
# Max events kept in Redis Stream (older ones trimmed automatically).
SCRAPE_EVENT_STREAM_MAXLEN=2000
# How often the SSE endpoint sends a keepalive ping (seconds).
SCRAPE_EVENTS_HEARTBEAT_SECONDS=15
FRONTEND_EDGE_PORT=3000
EDGE_SERVER_NAME=_

# Dedicated reusable ML dependency image tag. Bump this only when heavyweight
# ML dependencies or the Python base image change, then rebuild the ML base image.
ML_BASE_IMAGE=kocaelinewsmap-ml-base:py313-torch210-cpu-v3

# ===== Embedding =====
# Keep Docker/local runtime lean by default. Enable heavyweight providers only when
# you explicitly need semantic or multimodal embedding flows.
EMBEDDING_TEXT_PROVIDER=mock
EMBEDDING_TEXT_DIM=1024
DUPLICATE_THRESHOLD=0.90
DUPLICATE_TEXT_WEIGHT=1.00
EMBEDDING_COST_LOG=logs/embedding_cost.jsonl
CLASSIFIER_SEMANTIC_ENABLED=false
CLASSIFIER_SEMANTIC_THRESHOLD=0.3
CLASSIFIER_KEYWORD_ONLY=true

# ===== Optional Docker Build Flags =====
# Leave these false for normal local API/scraper work. Turning them on installs
# large optional dependency groups into the backend image. Set DOCKER_INSTALL_ML=true
# when EMBEDDING_* or NER_PROVIDER selects a real ML provider in Docker.
DOCKER_INSTALL_ML=false
DOCKER_INSTALL_DEV_TOOLS=false
DOCKER_INSTALL_OPTIONAL_INTEGRATIONS=false
DOCKER_INSTALL_PLAYWRIGHT_BROWSER=true
ML_SERVICE_TIMEOUT_SECONDS=180
ML_SERVICE_WARM_NER_PROVIDER=false
ML_SERVICE_WARM_TEXT_PROVIDER=false

# ===== Geocoding =====
GEOCODING_PROVIDER=mock
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=PULSE/1.0 kocaeli-news-platform
GEOCODING_TIMEOUT=10
GEOCODING_CACHE_TTL=86400
GEOCODING_MIN_CONFIDENCE=0.3

# ===== NER =====
NER_PROVIDER=mock
NER_MIN_SCORE=0.50
BERTTURK_MODEL_NAME=savasy/bert-base-turkish-ner-cased
GLINER_MODEL_NAME=urchade/gliner_multi-v2.1
GLINER_THRESHOLD=0.50

# Optional remote ML inference endpoint. Docker Compose injects this automatically
# for backend/worker/scheduler when the dedicated `ml` service is enabled.
# ML_SERVICE_URL=http://ml:8010

# ===== Next.js Public =====
NEXT_PUBLIC_API_URL=http://localhost:8000
# Frontend server-side routes should prefer the internal backend address.
# Local host setup can keep this equal to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:8000
# Include the temporary local QA server origin used by Playwright smoke checks.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3101

# ===== PWA / Push =====
# Keep false for normal development. Turn on only when you explicitly want to QA
# service worker / installability behavior against the local frontend.
NEXT_PUBLIC_ENABLE_PWA_IN_DEV=false
NEXT_PUBLIC_ENABLE_PUSH_TEST=false
ENABLE_PUSH_TEST_ENDPOINT=false
PUSH_TEST_API_KEY=
# Production push subscription storage prefers Mongo.
# Leave empty only if you intentionally want local file fallback.
PUSH_SUBSCRIPTIONS_MONGO_URL=
PUSH_SUBSCRIPTIONS_MONGO_DB=
PUSH_SUBSCRIPTIONS_COLLECTION=push_subscriptions
PUSH_SUBSCRIPTIONS_STORE_PATH=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
